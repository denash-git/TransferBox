#!/usr/bin/env bash
# =============================================================================
# TransferBox v4.0.0 Launcher (Modular Python TUI)
# =============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="${SCRIPT_DIR}"

# Проверка запуска от root
if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    echo -e "\033[1;31mОшибка: Для запуска утилиты требуются права root. Используйте: sudo menu\033[0m" >&2
    exit 1
fi

exec /usr/bin/python3 "${SCRIPT_DIR}/tui/app.py" "$@"
