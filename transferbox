#!/usr/bin/env bash
# =============================================================================
# TransferBox v4.0.0 Launcher (Modular Python TUI)
# =============================================================================
set -euo pipefail

# Resolve symlinks to find real project directory
TARGET="${BASH_SOURCE[0]}"
while [ -L "$TARGET" ]; do
    DIR="$(cd -P "$(dirname "$TARGET")" >/dev/null 2>&1 && pwd)"
    TARGET="$(readlink "$TARGET")"
    [[ $TARGET != /* ]] && TARGET="$DIR/$TARGET"
done
PROJECT_DIR="$(cd -P "$(dirname "$TARGET")" >/dev/null 2>&1 && pwd)"

# Fallback to standard installation directory if needed
if [ ! -f "${PROJECT_DIR}/tui/app.py" ] && [ -f "/opt/transferbox/tui/app.py" ]; then
    PROJECT_DIR="/opt/transferbox"
fi

export PYTHONPATH="${PROJECT_DIR}"

# Проверка запуска от root
if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    echo -e "\033[1;31mОшибка: Для запуска утилиты требуются права root. Используйте: sudo menu\033[0m" >&2
    exit 1
fi

exec /usr/bin/python3 "${PROJECT_DIR}/tui/app.py" "$@"
